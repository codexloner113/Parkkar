              }
            ],
            "url": "{{base_url}}/api/partner/revenue?range_start=2020-01-01T00:00:00Z&range_end=2030-01-01T00:00:00Z"
          }
        }
      ]
    },
    {
      "name": "ADMIN",
      "item": [
