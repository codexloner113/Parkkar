              "raw": "{\n  \"name\": \"New Test Location\",\n  \"propertyType\": \"HOTEL\",\n  \"address\": \"Some Road\",\n  \"city\": \"Kanpur\",\n  \"state\": \"Uttar Pradesh\",\n  \"postalCode\": \"208001\",\n  \"latitude\": 26.4499,\n  \"longitude\": 80.3319\n}"
            }
          }
        },
        {
          "name": "20. List own parking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{partner_token}}"
              }
            ],
            "url": "{{base_url}}/api/partner/parking"
          }
        },
        {
          "name": "21. Create slot",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) { pm.collectionVariables.set('partner_slot_id', json.data.id); }"
                ]
              }
            }
          ],
          "request": {
