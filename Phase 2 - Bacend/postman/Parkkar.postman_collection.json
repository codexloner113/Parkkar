            }
          }
        },
        {
          "name": "22. List slots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{partner_token}}"
              }
            ],
            "url": "{{base_url}}/api/partner/parking/{{partner_parking_id}}/slots"
          }
        },
        {
          "name": "23. Update slot",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{partner_token}}"
              }
            ],
            "url": "{{base_url}}/api/partner/slots/{{partner_slot_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceHour\": 50\n}"
            }
          }
        },
        {
          "name": "24. List global service catalog",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/services"
          }
        },
        {
          "name": "25. View own bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{partner_token}}"
              }
            ],
            "url": "{{base_url}}/api/partner/bookings"
          }
        },
        {
          "name": "26. View revenue",
